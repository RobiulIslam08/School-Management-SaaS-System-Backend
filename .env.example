PORT=4000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
OWNER_BOOTSTRAP_SKIP_2FA=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_ON_BOOT=true

# Vercel (new project): set only these in the dashboard. Do not upload this file.
# Required: MONGODB_URI
# Recommended: JWT_SECRET, JWT_REFRESH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD, OWNER_EMAIL, OWNER_PASSWORD
# Optional: FRONTEND_ORIGIN (set after the frontend URL exists), SEED_ON_BOOT, COOKIE_SECURE, COOKIE_SAMESITE
# Vercel already sets NODE_ENV=production. Do not set runtime in vercel.json.
